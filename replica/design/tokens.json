  "motion": {"fast": "100ms", "base": "160ms", "slow": "240ms", "ease": "cubic-bezier(.2,.8,.2,1)"},

  "size": {
    "_about": "Hauteurs de contrôle en px. Pointeur grossier (tactile) : coarse. Cible minimale WCAG 2.2 (2.5.8) : 24px, on ne descend jamais sous 28.",
