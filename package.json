{
  "name": "pdfreader",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "tokens": "python replica/design/build-tokens.py",
    "contrast": "python replica/design/check-contrast.py",
    "design": "npm run dev -w @pdfreader/design",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "i18n:extract": "python tools/i18n/extract.py && python tools/i18n/en.py",
    "i18n:check": "python tools/i18n/extract.py --check"
  }
}
