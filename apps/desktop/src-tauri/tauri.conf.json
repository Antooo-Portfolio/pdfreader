{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFReader",
  "version": "0.1.0",
  "identifier": "app.pdfreader.desktop",
  "build": {
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDFReader",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: http://pdfpage.localhost pdfpage:; connect-src 'self' ipc: http://ipc.localhost http://pdfpage.localhost pdfpage:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../vendor/pdfium-win-x64/bin/pdfium.dll": "pdfium.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF",
        "description": "Document PDF",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "shortDescription": "Lire, annoter et signer vos PDF, gratuitement.",
    "copyright": "PDFReader (nom de code)"
  },
  "mainBinaryName": "PDFReader"
}