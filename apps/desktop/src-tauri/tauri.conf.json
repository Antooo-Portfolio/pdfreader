{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFReader",
  "version": "0.2.0",
  "identifier": "app.pdfreader.desktop",
  "build": {
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDFReader",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: http://pdfpage.localhost pdfpage:; connect-src 'self' ipc: http://ipc.localhost http://pdfpage.localhost pdfpage:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../vendor/pdfium-win-x64/bin/pdfium.dll": "pdfium.dll",
      "legal/LICENCE.txt": "LICENCE.txt",
      "legal/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "legal/third-party.json": "third-party.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDFReader.Document",
        "description": "Document PDF",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "shortDescription": "Lire, annoter et signer vos PDF, gratuitement.",
    "copyright": "PDFReader (nom de code)",
    "licenseFile": "legal/LICENCE.txt",
    "publisher": "PDFReader",
    "longDescription": "Lire, annoter, remplir et signer des PDF, gratuitement et sans connexion.",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "PDFReader",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2OTVEQzM4REQ0MkY0NzQKUldSMDlFTGRPTnlWcGlMQmQxQ0RBWERqaVIrNkVOWGxlUlNBS0oxV2F1ZjJwU1gycFRzN29VcW0K",
      "endpoints": [
        "https://github.com/AntoooVVE/pdfreader-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
